transitions: (q0, a) -> q0, (q0, b) -> q0, (q0, b) -> q1, (q1, a) -> q1, (q1, b) -> q1
initial: q0
final: q1

entity: pda
name: anbn
states: p0, p1, p2
transitions: (p0, a, Z, A, Z) -> p0, (p0, a, A, A, A) -> p0
transitions: (p0, ε, A, A) -> p1, (p0, ε, Z, Z) -> p1
transitions: (p1, b, A, ε) -> p1, (p1, ε, Z, Z) -> p2
initial: p0
final: p2

entity: tm
name: contains-a-zero
states: scan, found
transitions: (scan, 1, 1, R) -> scan, (scan, 0, 1, S) -> found
